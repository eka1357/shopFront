# ==========================================================
# shopfront-agent: Environment Configuration Example
# Copy this file to .env and configure your credentials.
# ==========================================================

# OpenRouter API key for LLM inference (primary if using OpenRouter)
OPENROUTER_API_KEY=your-openrouter-api-key-here

# OpenRouter model identifier (default: openai/gpt-4o-mini)
OPENROUTER_MODEL=openai/gpt-4o-mini

# Direct OpenAI API key (alternative if not using OpenRouter)
OPENAI_API_KEY=your-openai-api-key-here

# Direct OpenAI model identifier (default: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# AWS region for native Amazon Bedrock Strands models (optional)
AWS_REGION=us-east-1

# Amazon Bedrock model identifier (optional, default: anthropic.claude-3-haiku-20240307-v1:0)
BEDROCK_MODEL=anthropic.claude-3-haiku-20240307-v1:0

# Toggle in-memory mock calendar (set to 'true' for local zero-credential demo)
MOCK_CALENDAR=true

# Path to Google Cloud Service Account JSON credentials file (for live calendar mode)
GOOGLE_SERVICE_ACCOUNT_FILE=credentials.json

# Target Google Calendar ID (default: 'primary')
GOOGLE_CALENDAR_ID=primary
